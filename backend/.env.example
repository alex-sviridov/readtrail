SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Trusted-header auth (see backend/pb_hooks/remoteUserAuth.pb.js).
# When enabled, PocketBase authenticates every request solely from
# REMOTE_USER_HEADER (containing the username) — password/token login is
# disabled. Only enable this if PocketBase is reachable exclusively through
# a reverse proxy that sets (and strips any client-supplied) these headers.
REMOTE_USER_ENABLED=false
REMOTE_USER_HEADER=X-Remote-User
REMOTE_USER_SECRET_HEADER=X-Remote-User-Secret
REMOTE_USER_SECRET=